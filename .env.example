# Entorno: production, development o testing.
APP_ENV=production

# URL pública completa. Con https las cookies de sesión se marcan como Secure.
APP_URL=https://example.com

# Zona horaria IANA. Define el mes detectado y las fechas mostradas.
APP_TIMEZONE=America/Mazatlan

# Hash generado con: php bin/hash-password.php
APP_PASSWORD_HASH=

# Subtítulo de la portada del PDF.
COVER_SUBTITLE="Portal: Proyecto Z"

# Directorio de estado. Debe quedar fuera del docroot (public/).
STORAGE_PATH=storage

# Límites de subida.
MAX_FILES=200
MAX_FILE_MB=25
MAX_TOTAL_MB=1024
MAX_PDF_MB=16
JPEG_QUALITY=82

# auto: worker CLI si el servidor puede lanzarlo; si no, procesa en línea.
# background: exige el worker CLI. inline: procesa al terminar la solicitud.
WORKER_MODE=auto

# Ruta del binario PHP CLI para el worker. Vacío usa el PHP actual.
PHP_CLI_BINARY=

# Detrás de Cloudflare con proxy activo: true usa CF-Connecting-IP
# como IP del cliente para el límite de intentos y los logs.
TRUST_PROXY=false

# Telegram: crea un bot con @BotFather y obtén el chat_id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Correo SMTP. MAIL_TO acepta varias direcciones separadas por comas.
# MAIL_ENCRYPTION: tls/starttls (587), ssl/smtps (465), none o vacío (sin cifrar).
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_ENCRYPTION=tls
MAIL_FROM=
MAIL_FROM_NAME=Testigos
MAIL_TO=
