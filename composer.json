{
    "name": "willy/testigos",
    "description": "Generador de PDF de capturas con envio por Telegram y correo",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.5",
        "ext-curl": "*",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-mbstring": "*",
        "phpmailer/phpmailer": "^6.9",
        "setasign/fpdf": "^1.8",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Willy\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Willy\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "check": [
            "@cs",
            "@stan",
            "@test",
            "@no-null",
            "@no-fqdn",
            "@oop"
        ],
        "cs": "php-cs-fixer fix --dry-run --diff",
        "stan": "phpstan analyse --memory-limit=512M",
        "test": "phpunit",
        "no-null": "php bin/check-no-null.php",
        "no-fqdn": "php bin/check-no-fqdn.php",
        "oop": "php bin/check-oop.php",
        "hash-password": "php bin/hash-password.php",
        "serve": "php -S localhost:8000 -t public bin/dev-router.php"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
